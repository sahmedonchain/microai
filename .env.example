# Copy to .env.local and fill in. Never commit real values.

# Required
GROQ_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random string used to sign session cookies
SESSION_SECRET=

# Optional
# Higher GitHub API rate limit for the Build status page
GITHUB_TOKEN=
# Pins the Sign-In with Ethereum domain (defaults to the request host)
SIWE_DOMAIN=
# Content-Security-Policy mode. Unset/0 = report-only (violations are logged, nothing is blocked).
# Set to 1 to enforce, after testing on a Vercel preview.
CSP_ENFORCE=
# Emergency kill switches. Set to 1 and redeploy to pause; clear and redeploy to resume.
# PAUSE_AI stops debug-analyze and the wallet summary.
PAUSE_AI=
# PAUSE_VERIFY stops the Verify endpoint checker (/api/verify).
PAUSE_VERIFY=

# Chat Swap (USDC <-> EURC). Swap stays disabled until BOTH are set. Server-side only: never prefix with NEXT_PUBLIC_.
# Circle API key for the Arc App Kit swap service (Circle Console, Keys). A legacy KIT_KEY value also works.
KIT_KEY=
# Public wallet address that receives the swap fee. An address only, never a private key.
TREASURY_ADDRESS=

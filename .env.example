# Copy to .env.local and fill in. Never commit real values.

# Required
GROQ_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random string used to sign session cookies
SESSION_SECRET=

# Optional
# Higher GitHub API rate limit for the Build status page
GITHUB_TOKEN=
# Pins the Sign-In with Ethereum domain (defaults to the request host)
SIWE_DOMAIN=
